# rmu-api-attack: local development outside Docker. Copy to .env.
# Requires the infrastructure started from rmu-platform (`make up-infra`).

# --- Server ------------------------------------------------------------------------------------
DEBUG=true
LOG_LEVEL=INFO

# --- MongoDB -----------------------------------------------------------------------------------
# MONGO_URI / MONGODB_URL and MONGO_DATABASE / MONGODB_DATABASE are still accepted (legacy names).
RMU_MONGO_ATTACK_URI=mongodb://admin:admin@localhost:27017/rmu-attack?authSource=admin
RMU_MONGO_ATTACK_DATABASE=rmu-attack

# --- Other APIs --------------------------------------------------------------------------------
# RMU_API_ATTACK_TABLES_URL is still accepted (legacy name).
RMU_API_ATTACK_TABLES_URI=http://localhost:3005/v1
# Attack tables client tuning (defaults shown).
# RMU_API_ATTACK_TABLES_TIMEOUT=30.0
# RMU_API_ATTACK_TABLES_KEY=
# RMU_API_ATTACK_TABLES_ENABLE_RETRY=false
# RMU_API_ATTACK_TABLES_MAX_RETRIES=3
# RMU_API_ATTACK_TABLES_RETRY_DELAY=1.0
